# Copy these two lines into rayfin/.env (create the file if it doesn't exist).
# rayfin/.env is ignored by git, so your IDs stay on your computer.
#
# Find both IDs in the address bar when you open your ExamCatalog lakehouse in Fabric:
#   https://app.fabric.microsoft.com/groups/<CATALOG_WORKSPACE_ID>/lakehouses/<CATALOG_LAKEHOUSE_ID>
CATALOG_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
CATALOG_LAKEHOUSE_ID=00000000-0000-0000-0000-000000000000
