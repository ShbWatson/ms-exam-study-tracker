# Copy these two lines into rayfin/.env (create the file if it doesn't exist).
# rayfin/.env is ignored by git, so your IDs stay on your computer.
#
# CATALOG_WORKSPACE_ID: the ID after /groups/ in the address bar of your workspace.
# CATALOG_SQL_ENDPOINT_ID: the ID of the ExamCatalog *SQL analytics endpoint*
#   (not the lakehouse). See step 5 in README.md for a one-line notebook cell
#   that lists it.
CATALOG_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
CATALOG_SQL_ENDPOINT_ID=00000000-0000-0000-0000-000000000000
